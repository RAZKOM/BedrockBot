{
  "name": "bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Minecraft Bedrock bot (TypeScript, Node 24, ESM)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "record:fixture": "node scripts/record-fixture.ts"
  },
  "dependencies": {
    "bedrock-protocol": "github:PrismarineJS/bedrock-protocol#c9e1fbf21dc6abde8d89920996575791b79e66cf",
    "minecraft-data": "3.117.0",
    "prismarine-chunk": "1.41.0",
    "prismarine-nbt": "2.8.0",
    "prismarine-registry": "1.12.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
