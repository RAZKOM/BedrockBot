  "patterns": [
    ["^(.+)_wall_hanging_sign$", "$1_hanging_sign"],
    ["^(?!.*(?:wall|hanging)_sign$)(.+)_sign$", "$1_standing_sign"],
    ["^(.+)_wall_banner$", "wall_banner"],
    ["^(.+)_banner$", "standing_banner"],
    ["^(.+)_bed$", "bed"],
    ["^potted_.+$", "flower_pot"]
  ],
  "byState": [
    { "java": "redstone_lamp", "prop": "lit", "value": "true", "bedrock": "lit_redstone_lamp" },
    { "java": "redstone_ore", "prop": "lit", "value": "true", "bedrock": "lit_redstone_ore" },
    { "java": "deepslate_redstone_ore", "prop": "lit", "value": "true", "bedrock": "lit_deepslate_redstone_ore" },
    { "java": "redstone_torch", "prop": "lit", "value": "false", "bedrock": "unlit_redstone_torch" },
    { "java": "redstone_wall_torch", "prop": "lit", "value": "false", "bedrock": "unlit_redstone_torch" },
    { "java": "repeater", "prop": "powered", "value": "true", "bedrock": "powered_repeater" },
    { "java": "comparator", "prop": "powered", "value": "true", "bedrock": "powered_comparator" },
    { "java": "daylight_detector", "prop": "inverted", "value": "true", "bedrock": "daylight_detector_inverted" },
    { "java": "piston_head", "prop": "type", "value": "sticky", "bedrock": "sticky_piston_arm_collision" },
    { "java": "cave_vines", "prop": "berries", "value": "true", "bedrock": "cave_vines_head_with_berries" },
    { "java": "cave_vines_plant", "prop": "berries", "value": "true", "bedrock": "cave_vines_body_with_berries" },
    { "java": "light", "prop": "level", "value": "*", "bedrock": "light_block_$" }
  ],
  "states": [
    { "match": "_stairs$", "map": {
      "facing": ["weirdo_direction", { "east": 0, "west": 1, "south": 2, "north": 3 }],
      "half": ["upside_down_bit", { "bottom": 0, "top": 1 }],
      "shape": ["minecraft:corner", { "straight": "none", "inner_left": "inner_left", "inner_right": "inner_right", "outer_left": "outer_left", "outer_right": "outer_right" }]
    } },
    { "match": "_slab$", "map": {
      "type": ["minecraft:vertical_half", { "bottom": "bottom", "top": "top", "double": "bottom" }]
    } },
    { "match": "_trapdoor$", "map": {
      "facing": ["direction", { "east": 0, "west": 1, "south": 2, "north": 3 }],
      "half": ["upside_down_bit", { "bottom": 0, "top": 1 }],
      "open": ["open_bit", "bool"]
    } },
    { "match": "_door$", "map": {
      "facing": ["minecraft:cardinal_direction", "same"],
      "half": ["upper_block_bit", { "lower": 0, "upper": 1 }],
      "hinge": ["door_hinge_bit", { "left": 0, "right": 1 }],
      "open": ["open_bit", "bool"]
    } },
    { "match": "_fence_gate$", "map": {
      "facing": ["minecraft:cardinal_direction", "same"],
      "open": ["open_bit", "bool"],
      "in_wall": ["in_wall_bit", "bool"]
    } },
    { "match": "_bed$", "map": {
      "facing": ["direction", { "south": 0, "west": 1, "north": 2, "east": 3 }],
      "part": ["head_piece_bit", { "foot": 0, "head": 1 }],
      "occupied": ["occupied_bit", "bool"]
    } },
    { "match": "_wall$", "map": {
      "north": ["wall_connection_type_north", { "none": "none", "low": "short", "tall": "tall" }],
      "east": ["wall_connection_type_east", { "none": "none", "low": "short", "tall": "tall" }],
      "south": ["wall_connection_type_south", { "none": "none", "low": "short", "tall": "tall" }],
      "west": ["wall_connection_type_west", { "none": "none", "low": "short", "tall": "tall" }],
      "up": ["wall_post_bit", "bool"]
    } },
    { "match": "(_fence|_pane|_bars)$", "map": {
      "north": ["minecraft:connection_north", "bool"],
      "east": ["minecraft:connection_east", "bool"],
      "south": ["minecraft:connection_south", "bool"],
      "west": ["minecraft:connection_west", "bool"]
    } },
    { "match": "torch$", "map": { "facing": ["torch_facing_direction", { "north": "south", "south": "north", "east": "west", "west": "east" }] }, "set": { "torch_facing_direction": "top" } },
    { "match": "^vine$", "bits": ["vine_direction_bits", { "south": 1, "west": 2, "north": 4, "east": 8 }] },
    { "match": "^tall_seagrass$", "map": { "half": ["sea_grass_type", { "lower": "double_bot", "upper": "double_top" }] } },
    { "match": "_skull$|_head$", "set": { "facing_direction": 1 } },
    { "match": "_wall_hanging_sign$", "set": { "hanging": 0 } },
    { "match": "^nether_portal$", "map": { "axis": ["portal_axis", "same"] } },
    { "match": "^snow$", "map": { "layers": ["height", "int-1"] } },
    { "match": "^(wheat|carrots|potatoes)$", "map": { "age": ["growth", "int"] } },
    { "match": "^farmland$", "map": { "moisture": ["moisturized_amount", "int"] } },
    { "match": "candle$", "map": { "candles": ["candles", "int-1"], "lit": ["lit", "bool"] } },
    { "match": "^sea_pickle$", "map": { "pickles": ["cluster_count", "int-1"], "waterlogged": ["dead_bit", "not"] } },
    { "match": "^cake$", "map": { "bites": ["bite_counter", "int"] } },
    { "match": "^composter$", "map": { "level": ["composter_fill_level", "int"] } },
    { "match": "^respawn_anchor$", "map": { "charges": ["respawn_anchor_charge", "int"] } },
    { "match": "^campfire$|^soul_campfire$", "map": { "lit": ["extinguished", "not"] } },
    { "match": "_leaves$", "map": { "persistent": ["persistent_bit", "bool"] } },
    { "match": "", "map": {
      "axis": ["pillar_axis", "same"],
      "rotation": ["ground_sign_direction", "int"],
      "hanging": ["hanging", "bool"],
      "attached": ["attached_bit", "bool"],
      "open": ["open_bit", "bool"],
      "powered": ["powered_bit", "bool"],
      "lit": ["lit", "bool"],
      "age": ["age", "int"],
      "honey_level": ["honey_level", "int"],
      "half": ["upper_block_bit", { "lower": 0, "upper": 1 }]
    } },
    { "match": "", "map": { "facing": ["minecraft:cardinal_direction", "same"] } },
    { "match": "", "map": { "facing": ["facing_direction", { "down": 0, "up": 1, "north": 2, "south": 3, "west": 4, "east": 5 }] } },
    { "match": "", "map": { "facing": ["minecraft:block_face", "same"] } },
    { "match": "", "map": { "facing": ["minecraft:facing_direction", "same"] } },
    { "match": "", "map": { "facing": ["direction", { "south": 0, "west": 1, "north": 2, "east": 3 }] } }
  ],
