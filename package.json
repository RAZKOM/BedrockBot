{
  "name": "bedrockbot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bds:up": "node scripts/bds.mjs up",
    "bds:down": "node scripts/bds.mjs down",
    "bds:restart": "node scripts/bds.mjs restart",
    "bds:idle": "node scripts/bds.mjs idle",
    "bds:cmd": "node scripts/bds.mjs cmd",
    "bds:logs": "node scripts/bds.mjs logs",
    "pack:deploy": "pnpm --filter @bedrockbot/truth-pack pack:deploy --data ../../docker/data/dev --restart bds-dev && node scripts/bds.mjs up",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "bot:afk": "pnpm --filter bot start -- --task afk",
    "bds60:up": "node scripts/bds.mjs --profile dev60 up",
    "bdsnn:up": "node scripts/bds.mjs --profile nn up",
    "e2e:60": "pnpm --filter bot exec node scripts/e2e-profile.ts dev60",
    "e2e:nn": "pnpm --filter bot exec node scripts/e2e-profile.ts nn"
  }
}
